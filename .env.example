# MorePlay 常用部署模板，请填写后通过 environment/env_file/--env-file 加载。
# 空猫源地址可以先启动管理台，再在网页添加输入源。
CATPAW_SOURCE_URL=
CATPAW_SETTINGS_PASSWORD=change-this-password
REQUIRE_MD5=true

# 以下按需要取消注释。TMDB 在 STRM 页面也可配置。
# CATPAW_TMDB_API_KEY=
# CATPAW_TMDB_READ_TOKEN=
# CATPAW_TMDB_PROXY=

# 只填写需要强制经图片代理的域名，多个域名用英文逗号分隔。
# CATPAW_POSTER_PROXY_HOSTS=

# 普通 HTTP/远程 T4 输入不需要 Spider 服务。
# CATPAW_TVBOX_RUNTIME_URL=
# CATPAW_TVBOX_RUNTIME_TOKEN=
